# ─── ESPN (private league) ───────────────────────────────────────────────
# From a logged-in ESPN browser session (DevTools → Application → Cookies → espn.com)
ESPN_S2=
ESPN_SWID={xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
# From your league URL: .../leagueId=XXXXXX
LEAGUE_ID=
# NFL season year (the year the season starts)
SEASON_YEAR=2026
# The Tuesday you want the Week 1 recap sent — i.e. the day after Week 1's Monday Night
# Football. Every 7 days after this = the next week. (YYYY-MM-DD)
SEASON_WEEK1_TUESDAY=2026-09-15

# ─── Claude (your personal Anthropic key) ────────────────────────────────
# From console.anthropic.com — billed to your personal account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Resend (email delivery) ─────────────────────────────────────────────
# Free API key from resend.com. On the free tier, keep EMAIL_FROM as the
# default and set RECIPIENT_EMAIL to the address you signed up with.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
RECIPIENT_EMAIL=
