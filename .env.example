# Per-league config (league id, ESPN league ID, season dates, recipients) lives in the
# committed `leagues.json`, not here. This file only holds the SHARED secrets used across
# every league, plus the one secret that carries every league's ESPN cookies.

# ─── ESPN cookies for every private league, keyed by leagues.json's "id" ─────────────────
# From a logged-in ESPN browser session (DevTools → Application → Cookies → espn.com).
# Public leagues (requiresAuth: false in leagues.json) don't need an entry here.
LEAGUE_SECRETS_JSON={"main":{"espnS2":"...","swid":"{xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}"}}

# ─── Claude (your personal Anthropic key) ────────────────────────────────
# From console.anthropic.com — billed to your personal account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Resend (email delivery) ─────────────────────────────────────────────
# Free API key from resend.com. On the free tier, keep EMAIL_FROM as the default.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ─── Failure alerts ───────────────────────────────────────────────────────
# Where "this league's recap failed to send" alerts go. Owner-only, not the friend groups.
OWNER_ALERT_EMAIL=
